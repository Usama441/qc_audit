<% content_for :page_title, "Audit Settings" %>

<% enabled_rule_count = @setting.enabled_rule_count %>
<% total_rule_count = AuditRuleCatalog.rule_keys.length %>

<div class="settings-page">
  <div class="settings-summary-card">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Global Rules</p>
        <h2 class="text-xl font-bold text-gray-900 mt-1">Audit check settings</h2>
        <p class="text-sm text-gray-500 mt-2">
          These toggles control which detailed audit rules run for future uploads. Each audit keeps its own snapshot after upload.
        </p>
      </div>
      <div class="rounded-2xl bg-slate-50 px-4 py-3 text-right">
        <p class="text-2xl font-bold text-slate-900"><%= enabled_rule_count %>/<%= total_rule_count %></p>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mt-1">Rules Enabled</p>
      </div>
    </div>
  </div>

  <%= form_with url: settings_path, method: :patch, class: "space-y-6", data: { settings_form: true } do %>
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2 flex-wrap">
        <button
          type="button"
          data-settings-enable-all
          class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 text-slate-700 hover:bg-white cursor-pointer"
        >
          Enable All
        </button>
        <button
          type="button"
          data-settings-disable-all
          class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 text-slate-700 hover:bg-white cursor-pointer"
        >
          Disable All
        </button>
        <%= link_to "Reset Defaults",
              reset_settings_path,
              data: { turbo_method: :post },
              class: "px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer" %>
      </div>
      <%= submit_tag "Save Settings", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl cursor-pointer transition-colors shadow-sm" %>
    </div>

    <% @sections.each do |section| %>
      <div class="settings-section-card">
        <div class="settings-section-header">
          <div>
            <h3 class="text-sm font-bold text-gray-900"><%= section[:section_label] %></h3>
            <p class="text-xs text-gray-400 mt-1"><%= section[:enabled_count] %>/<%= section[:total_count] %> enabled</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700"><%= section[:total_count] %> rules</span>
        </div>

        <div class="divide-y divide-gray-100">
          <% section[:rules].each do |rule| %>
            <label class="settings-rule-row cursor-pointer">
              <div class="min-w-0 pr-4">
                <p class="text-sm font-semibold text-gray-900"><%= rule[:rule_label] %></p>
                <% if rule[:description].present? %>
                  <p class="text-xs text-gray-500 mt-1"><%= rule[:description] %></p>
                <% end %>
              </div>
              <div class="shrink-0">
                <%= check_box_tag "settings[enabled_rules][#{rule[:rule_key]}]",
                      "1",
                      rule[:enabled],
                      class: "settings-toggle",
                      data: { settings_toggle: true } %>
                <span class="settings-toggle-shell" aria-hidden="true"></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  const initializeSettingsToggles = function () {
    const form = document.querySelector("[data-settings-form]");
    if (!form || form.dataset.settingsInitialized === "true") return;

    const toggles = Array.from(form.querySelectorAll("[data-settings-toggle]"));
    const enableAll = form.querySelector("[data-settings-enable-all]");
    const disableAll = form.querySelector("[data-settings-disable-all]");

    if (enableAll) {
      enableAll.addEventListener("click", function () {
        toggles.forEach(function (toggle) {
          toggle.checked = true;
        });
      });
    }

    if (disableAll) {
      disableAll.addEventListener("click", function () {
        toggles.forEach(function (toggle) {
          toggle.checked = false;
        });
      });
    }

    form.dataset.settingsInitialized = "true";
  };

  document.addEventListener("DOMContentLoaded", initializeSettingsToggles);
  document.addEventListener("turbo:load", initializeSettingsToggles);
</script>
