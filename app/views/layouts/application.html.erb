<!DOCTYPE html>
<html lang="en" class="app-html">
  <head>
    <title><%= content_for(:title) || "QC Audit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag "favicon/favicon.ico" %>
    <%= favicon_link_tag "favicon/favicon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "favicon/favicon-96x96.png", type: "image/png", sizes: "96x96" %>
    <%= tag.link rel: "apple-touch-icon", href: asset_path("favicon/apple-touch-icon.png"), sizes: "180x180" %>
    <%= tag.link rel: "manifest", href: asset_path("favicon/site.webmanifest") %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body <%= "#{controller_name}-#{action_name}" %>">
    <div class="app-shell">

      <%# ── Sidebar ────────────────────────────────────────────────────── %>
      <aside class="app-sidebar">

        <%# Logo %>
        <div class="app-sidebar-brand">
          <%= render "layouts/sidebar_logo" %>
        </div>

        <%# Navigation %>
        <nav class="app-nav">
          <p class="app-nav-label">Main</p>

          <%= link_to audits_path,
                class: "app-nav-link #{request.path == '/' || request.path == audits_path ? 'is-active' : ''}" do %>
            <%= image_tag "pngs/dashboard.png", alt: "", class: "app-nav-image" %>
            Dashboard
          <% end %>

          <%= link_to new_audit_path,
                class: "app-nav-link #{request.path == new_audit_path ? 'is-active' : ''}" do %>
            <%= image_tag "pngs/management.png", alt: "", class: "app-nav-image" %>
            New Audit
          <% end %>

          <%= link_to settings_path,
                class: "app-nav-link #{request.path == settings_path ? 'is-active' : ''}" do %>
            <svg class="app-nav-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9m-9 6h9m-9 6h9M4.5 6h.008v.008H4.5V6Zm0 6h.008v.008H4.5V12Zm0 6h.008v.008H4.5V18Z"/>
            </svg>
            Settings
          <% end %>
        </nav>

        <%# Sidebar footer %>
        <div class="app-sidebar-footer">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-green-400"></div>
            <p class="text-xs text-slate-400">System Online</p>
          </div>
        </div>
      </aside>

      <%# ── Main area ──────────────────────────────────────────────────── %>
      <div class="app-main-shell">

        <%# Top bar %>
        <header class="app-topbar">
          <div>
            <h1 class="app-topbar-title"><%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %></h1>
            <p class="app-topbar-date"><%= Time.current.strftime("%A, %d %B %Y") %></p>
          </div>
          <%= link_to new_audit_path, class: "app-primary-action" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            New Audit
          <% end %>
        </header>

        <%# Flash messages %>
        <% if notice.present? %>
          <div class="app-flash app-flash-notice">
            <svg class="w-4 h-4 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
            </svg>
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="app-flash app-flash-alert">
            <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>
            </svg>
            <%= alert %>
          </div>
        <% end %>

        <%# Page content %>
        <main class="app-page-content">
          <%= yield %>
        </main>

      </div>
    </div>
  </body>
</html>
