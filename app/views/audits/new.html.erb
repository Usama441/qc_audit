<% content_for :page_title, "New Audit Upload" %>

<% enabled_rule_count = AuditSetting.instance.enabled_rule_count %>
<div class="audit-new-page">

  <%# Page header %>
  <div class="mb-6">
    <h2 class="text-xl font-bold text-gray-900">Upload Excel Workbook</h2>
    <p class="text-sm text-gray-500 mt-1">
      Upload a single <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs font-mono">.xlsx</code> workbook with all financial statement sheets.
      The system will run the <strong><%= enabled_rule_count %> enabled audit rules</strong> from your global settings.
    </p>
    <p class="text-xs text-slate-500 mt-2">
      Need to change which rules run?
      <%= link_to "Open Settings", settings_path, class: "font-semibold text-indigo-600 hover:text-indigo-700" %>
    </p>
  </div>

  <div class="audit-new-card">
    <%= form_with model: @upload, url: audits_path, class: "space-y-6" do |f| %>

      <%# Validation errors %>
      <% if @upload.errors.any? %>
        <div class="flex gap-3 bg-red-50 border border-red-200 rounded-xl p-4">
          <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>
          </svg>
          <div class="text-sm text-red-700">
            <p class="font-semibold mb-1">Please fix the following:</p>
            <ul class="list-disc list-inside space-y-0.5">
              <% @upload.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <%# Entity type %>
      <div>
        <%= f.label :free_zone, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Entity / Free Zone Type
          <span class="text-red-500 ml-0.5">*</span>
        <% end %>
        <div class="audit-new-zone-grid">
          <% [
            ["mainland",    "Mainland",         "Standard UAE entity, no statutory reserve requirement."],
            ["freezone_10", "Free Zone (10%)",  "Free zone entity — 10% statutory reserve applies."],
            ["freezone_5",  "Free Zone (5%)",   "Free zone entity — 5% statutory reserve applies."],
          ].each do |value, label, desc| %>
            <label
              data-free-zone-option
              class="relative flex flex-col gap-1 cursor-pointer rounded-xl border-2 p-4 transition-all hover:border-indigo-300
                          <%= @upload.free_zone == value ? 'border-indigo-600 bg-indigo-50' : 'border-gray-200 bg-white' %>">
              <%= f.radio_button :free_zone, value, class: "sr-only", data: { free_zone_input: true } %>
              <span class="text-sm font-semibold text-gray-800"><%= label %></span>
              <span class="text-xs text-gray-500 leading-snug"><%= desc %></span>
              <div
                data-free-zone-check
                class="absolute top-3 right-3 w-4 h-4 rounded-full bg-indigo-600 flex items-center justify-center <%= @upload.free_zone == value ? '' : 'hidden' %>">
                  <svg class="w-2.5 h-2.5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                  </svg>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <%# File upload %>
      <div>
        <%= f.label :excel_file, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          Excel Workbook
          <span class="text-red-500 ml-0.5">*</span>
        <% end %>
        <div data-controller="file-upload">
          <div data-file-upload-target="zone"
               data-action="dragover->file-upload#dragover dragleave->file-upload#dragleave drop->file-upload#drop"
               class="relative flex flex-col items-center justify-center w-full border-2 border-dashed border-gray-200 rounded-xl px-6 py-10 text-center transition-colors cursor-pointer bg-gray-50">

            <div data-file-upload-target="icon">
              <svg class="w-10 h-10 text-gray-300 mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m6.75 12-3-3m0 0-3 3m3-3v6m-1.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
              </svg>
            </div>

            <div data-file-upload-target="label">
              <p class="text-sm font-medium text-gray-600">Drop your file here, or <span class="text-indigo-600">browse</span></p>
              <p class="text-xs text-gray-400 mt-1">Supports .xlsx — one workbook with all sheets</p>
            </div>

            <%= f.file_field :excel_file, accept: ".xlsx",
                  data: { "file-upload-target": "input" },
                  class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer" %>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-400">Expected sheets: Trial Balance, Balance Sheet, P&L, SoCE, Cash Flow, and supporting schedules.</p>
      </div>

      <%# QC checks info %>
      <div class="audit-new-helper-card">
        <p class="text-xs font-semibold text-slate-600 mb-2">Rule groups available in Settings:</p>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1">
          <% [
            "General Ledger", "Trial Balance",
            "Balance Sheet",  "Profit & Loss",
            "Equity Statement", "Cash Flow",
            "Prepayment",     "Sales",
            "SL Control",     "PL Control",
            "Bank Control",   "Accruals",
            "Share Capital",  "VAT Control",
          ].each do |check| %>
            <div class="flex items-center gap-1.5 text-xs text-slate-500">
              <svg class="w-3 h-3 text-indigo-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
              </svg>
              <%= check %>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-slate-500 mt-3">
          Snapshot locked at upload time. Later Settings changes will not change this audit run.
        </p>
      </div>

      <%# Submit %>
      <div class="flex items-center justify-between pt-2">
        <%= link_to audits_path, class: "text-sm text-gray-400 hover:text-gray-600" do %>
          ← Back to Dashboard
        <% end %>
        <%= f.submit "Run Audit Checks →",
              class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl cursor-pointer transition-colors shadow-sm" %>
      </div>

    <% end %>
  </div>
</div>

<script>
  const initializeFreeZoneSelection = function () {
    const options = Array.from(document.querySelectorAll("[data-free-zone-option]"));
    const inputs = Array.from(document.querySelectorAll("[data-free-zone-input]"));

    if (!options.length || !inputs.length) return;
    if (options[0].dataset.freeZoneInitialized === "true") return;

    const updateSelection = function () {
      options.forEach(function (option) {
        const input = option.querySelector("[data-free-zone-input]");
        const check = option.querySelector("[data-free-zone-check]");
        const isSelected = !!input && input.checked;

        option.classList.toggle("border-indigo-600", isSelected);
        option.classList.toggle("bg-indigo-50", isSelected);
        option.classList.toggle("shadow-sm", isSelected);
        option.classList.toggle("border-gray-200", !isSelected);
        option.classList.toggle("bg-white", !isSelected);

        if (check) {
          check.classList.toggle("hidden", !isSelected);
        }
      });
    };

    inputs.forEach(function (input) {
      input.addEventListener("change", updateSelection);
    });

    options.forEach(function (option) {
      option.dataset.freeZoneInitialized = "true";
    });

    updateSelection();
  };

  document.addEventListener("DOMContentLoaded", initializeFreeZoneSelection);
  document.addEventListener("turbo:load", initializeFreeZoneSelection);
</script>
