<% content_for :page_title, @upload.excel_file.attached? ? @upload.excel_file.filename.to_s : "Audit ##{@upload.id}" %>

<div class="audit-show-page" data-audit-shell data-poll-url="<%= audit_path(@upload, format: :json) %>" data-processing="<%= @report&.processing? ? 'true' : 'false' %>">
  <div class="flex items-center gap-2 text-xs text-gray-400 mb-5">
    <%= link_to "Dashboard", audits_path, class: "hover:text-indigo-600" %>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
    <span class="text-gray-600 font-medium truncate max-w-[200px]"><%= @upload.excel_file.attached? ? @upload.excel_file.filename : "Audit ##{@upload.id}" %></span>
  </div>

  <div class="audit-show-file-card">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-green-50">
          <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-gray-900">
            <%= @upload.excel_file.attached? ? @upload.excel_file.filename : "Audit ##{@upload.id}" %>
          </h2>
          <div class="flex items-center gap-3 mt-1 text-xs text-gray-400">
            <span><%= case @upload.free_zone
                      when "mainland" then "Mainland"
                      when "freezone_10" then "Free Zone (10% reserve)"
                      when "freezone_5" then "Free Zone (5% reserve)"
                      end %></span>
            <span class="text-gray-200">|</span>
            <span>Uploaded <%= @upload.created_at.strftime("%d %b %Y at %H:%M") %></span>
          </div>
        </div>
      </div>

      <div data-audit-status-badge>
        <%= render "status_badge", upload: @upload %>
      </div>
    </div>
  </div>

  <div data-audit-live-progress>
    <%= render "live_progress", report: @report %>
  </div>

  <div data-audit-results>
    <%= render "results", upload: @upload, report: @report %>
  </div>
</div>

<script>
  const initializeAuditFilters = function () {
    const cards = Array.from(document.querySelectorAll("[data-filter-card]"));
    const rows = Array.from(document.querySelectorAll("[data-check-row]"));
    const categories = Array.from(document.querySelectorAll("[data-category-section]"));
    const label = document.getElementById("audit-filter-label");

    if (!cards.length || !rows.length) return;
    if (cards[0].dataset.auditFiltersInitialized === "true") return;

    const filterLabels = {
      pass: "passed",
      fail: "failed",
      warning: "warning",
      skip: "skipped"
    };

    const applyFilter = function (filter) {
      const activeFilter = filter === "all" ? null : filter;

      cards.forEach(function (card) {
        const isActive = card.dataset.filter === filter;
        card.classList.toggle("ring-2", isActive);
        card.classList.toggle("ring-slate-900", isActive);
        card.classList.toggle("scale-[1.02]", isActive);
        card.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      rows.forEach(function (row) {
        const matches = !activeFilter || row.dataset.status === activeFilter;
        row.classList.toggle("hidden", !matches);
      });

      categories.forEach(function (section) {
        const visibleRows = section.querySelectorAll("[data-check-row]:not(.hidden)");
        section.classList.toggle("hidden", visibleRows.length === 0);
      });

      if (label) {
        const displayFilter = filterLabels[activeFilter] || activeFilter;
        label.textContent = activeFilter ? `Showing ${displayFilter} results` : "Showing all results";
      }
    };

    cards.forEach(function (card) {
      card.dataset.auditFiltersInitialized = "true";
      card.addEventListener("click", function () {
        const nextFilter = card.dataset.filter;
        const isAlreadyActive = card.getAttribute("aria-pressed") === "true";
        applyFilter(isAlreadyActive && nextFilter !== "all" ? "all" : nextFilter);
      });
    });

    applyFilter("all");
  };

  const initializeProgressMeters = function () {
    const meters = Array.from(document.querySelectorAll("[data-progress-meter]"));
    if (!meters.length) return;

    meters.forEach(function (meter) {
      const segments = Array.from(meter.querySelectorAll("[data-progress-segment]"));
      segments.forEach(function (segment) {
        const width = Number(segment.dataset.width || 0);
        segment.style.width = `${Math.max(width, 0)}%`;
      });
    });
  };

  const initializeCompletedLogToggle = function () {
    const summary = document.querySelector("[data-completed-log-summary]");
    const details = document.querySelector("[data-completed-log-details]");
    const buttons = Array.from(document.querySelectorAll("[data-toggle-completed-log]"));

    if (!summary || !details || !buttons.length) return;
    if (buttons[0].dataset.completedLogInitialized === "true") return;

    const setExpanded = function (expanded) {
      summary.classList.toggle("hidden", expanded);
      details.classList.toggle("hidden", !expanded);
    };

    buttons.forEach(function (button) {
      button.dataset.completedLogInitialized = "true";
      button.addEventListener("click", function () {
        const shouldExpand = details.classList.contains("hidden");
        setExpanded(shouldExpand);
      });
    });

    setExpanded(false);
  };

  const initializeAuditPolling = function () {
    const shell = document.querySelector("[data-audit-shell]");
    if (!shell) return;

    if (window.auditPollingTimeout) {
      clearTimeout(window.auditPollingTimeout);
      window.auditPollingTimeout = null;
    }

    const pollUrl = shell.dataset.pollUrl;
    if (!pollUrl) return;

    const statusBadge = shell.querySelector("[data-audit-status-badge]");
    const liveProgress = shell.querySelector("[data-audit-live-progress]");
    const results = shell.querySelector("[data-audit-results]");

    const applyPayload = function (payload) {
      shell.dataset.processing = payload.processing ? "true" : "false";

      if (statusBadge && typeof payload.status_badge_html === "string") {
        statusBadge.innerHTML = payload.status_badge_html;
      }
      if (liveProgress && typeof payload.live_progress_html === "string") {
        liveProgress.innerHTML = payload.live_progress_html;
      }
      if (results && typeof payload.results_html === "string") {
        results.innerHTML = payload.results_html;
      }

      initializeAuditFilters();
      initializeCompletedLogToggle();
      initializeProgressMeters();
    };

    const scheduleNextPoll = function () {
      if (shell.dataset.processing !== "true") return;
      window.auditPollingTimeout = setTimeout(fetchAuditState, 1000);
    };

    const fetchAuditState = function () {
      fetch(pollUrl, {
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest"
        },
        credentials: "same-origin"
      })
        .then(function (response) {
          if (!response.ok) throw new Error("Audit polling failed");
          return response.json();
        })
        .then(function (payload) {
          applyPayload(payload);
          scheduleNextPoll();
        })
        .catch(function () {
          scheduleNextPoll();
        });
    };

    initializeAuditFilters();
    initializeCompletedLogToggle();
    initializeProgressMeters();
    scheduleNextPoll();
  };

  document.addEventListener("DOMContentLoaded", initializeAuditPolling);
  document.addEventListener("turbo:load", initializeAuditPolling);
</script>
